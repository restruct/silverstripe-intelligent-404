{
    "name": "restruct/silverstripe-intelligent-404",
    "description": "Send a 404 to the page the visitor meant: matches the missing URL against the site tree, exactly and by sound, then redirects (301) or lists the options on the error page",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "silverstripe-module",
        "silverstripe-cms",
        "404",
        "redirects",
        "error-page",
        "seo"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Restruct",
            "email": "dev@restruct.nl",
            "homepage": "https://restruct.nl"
        },
        {
            "name": "Ralph Slooten",
            "homepage": "http://www.axllent.org/"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5 || ^6",
        "silverstripe/cms": "^5 || ^6",
        "silverstripe/errorpage": "^2 || ^3"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ],
    "autoload": {
        "psr-4": {
            "Restruct\\Silverstripe\\Intelligent404\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\Silverstripe\\Intelligent404\\Tests\\": "tests/"
        }
    }
}
