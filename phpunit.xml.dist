<?xml version="1.0" encoding="UTF-8"?>
<!-- Runs from a host project with this module installed as a symlinked path repository (see
     README "Running the tests"). failOnWarning is pinned because warning-to-error escalation is
     the test RUNNER's behaviour and differs by PHPUnit major: 9 (Silverstripe 5) converts
     warnings by default, 11 (Silverstripe 6) does not. -->
<phpunit bootstrap="vendor/silverstripe/framework/tests/bootstrap.php" colors="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="intelligent404">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
